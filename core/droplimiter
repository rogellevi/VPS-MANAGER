#!/bin/bash
# ==========================================
# DROPLIMITER - VPS MANAGER V5.2
# Limita conexiones simultáneas en Dropbear
# ==========================================

# Colores del VPS Manager
C_RST='\033[0m'
C_RED='\033[1;31m'
C_GREEN='\033[1;32m'
C_YELLOW='\033[1;33m'
C_CYAN='\033[1;36m'
C_NEON_BLUE='\033[38;5;39m'
C_NEON_GREEN='\033[38;5;46m'
C_NEON_YELLOW='\033[38;5;226m'
BG_RED='\033[41;1;37m'
BG_GREEN='\033[42;1;37m'
BG_YELLOW='\033[43;1;30m'

VPS_DIR="/etc/vps-manager"
LOG_FILE="/var/log/auth.log"
[ ! -f "$LOG_FILE" ] && LOG_FILE="/var/log/secure"

# Función para contar conexiones activas de un usuario en dropbear
contar_conexiones_dropbear() {
    local user="$1"
    # Método 1: Contar procesos dropbear del usuario
    local count=$(ps -ef 2>/dev/null | grep "dropbear" | grep -w "$user" | grep -v grep | wc -l)
    
    # Método 2 (fallback): Buscar en log de auth
    if [ "$count" -eq 0 ]; then
        # Obtener PIDs activos de dropbear para este usuario
        local pids=$(ps -ef | grep "dropbear" | grep -w "$user" | grep -v grep | awk '{print $2}')
        for pid in $pids; do
            if grep -q "$pid" "$LOG_FILE" 2>/dev/null; then
                if grep "$pid" "$LOG_FILE" | grep -q "Password auth succeeded\|Password authentication succeeded"; then
                    count=$((count + 1))
                fi
            fi
        done
    fi
    
    echo "$count"
}

# Función para obtener PIDs de dropbear de un usuario
obtener_pids_usuario() {
    local user="$1"
    ps -ef | grep "dropbear" | grep -w "$user" | grep -v grep | awk '{print $2}'
}

# Verificar que dropbear esté activo
if ! pgrep -x "dropbear" >/dev/null 2>&1; then
    echo -e "${C_RED}[!] Dropbear no está activo. Saliendo...${C_RST}"
    sleep 2
    exit 1
fi

# Loop principal
while true; do
    clear
    echo -e "${C_NEON_BLUE}╔══════════════════════════════════════════════╗${C_RST}"
    echo -e "${C_NEON_BLUE} ${C_NEON_GREEN}        🛡️ LIMITER DROPBEAR - VPS MANAGER      ${C_NEON_BLUE} ${C_RST}"
    echo -e "${C_NEON_BLUE}╠══════════════════════════════════════════════╣${C_RST}"
    printf "  ${C_CYAN}%-20s %-15s %-15s${C_RST}\n" "USUARIO" "CONEXIONES" "LÍMITE"
    echo -e "${C_NEON_BLUE}╠══════════════════════════════════════════════╣${C_RST}"
    
    # Recorrer todos los usuarios del sistema (UID >= 1000)
    usuarios_procesados=0
    for user in $(awk -F: '$3 >= 1000 && $1 != "nobody" {print $1}' /etc/passwd); do
        # Obtener límite del usuario
        limite_file="$VPS_DIR/limite_${user}"
        if [ -f "$limite_file" ]; then
            limite=$(cat "$limite_file" 2>/dev/null)
        else
            limite=1
        fi
        
        # Validar que sea número
        [[ ! "$limite" =~ ^[0-9]+$ ]] && limite=1
        
        # Contar conexiones activas
        conexiones=$(contar_conexiones_dropbear "$user")
        
        # Determinar color según estado
        if [ "$conexiones" -eq 0 ]; then
            color_conn="${C_RED}"
            estado="○"
        elif [ "$conexiones" -le "$limite" ]; then
            color_conn="${C_GREEN}"
            estado="●"
        else
            color_conn="${C_RED}"
            estado="⚠"
        fi
        
        # Mostrar información
        printf "  ${estado} %-19s ${color_conn}%-15s${C_RST} ${C_NEON_YELLOW}%-15s${C_RST}\n" \
            "$user" "$conexiones/$limite" "$limite"
        
        # Si excede el límite, matar conexiones extra
        if [ "$conexiones" -gt "$limite" ]; then
            echo -e "  ${BG_RED} ⚠ $user excedió el límite. Desconectando... ${C_RST}"
            
            # Obtener PIDs y matar los más antiguos (dejar solo los del límite)
            pids=$(obtener_pids_usuario "$user")
            pid_count=0
            for pid in $pids; do
                pid_count=$((pid_count + 1))
                if [ "$pid_count" -gt "$limite" ]; then
                    kill -9 "$pid" 2>/dev/null
                    echo -e "  ${C_YELLOW}   ↳ PID $pid terminado${C_RST}"
                fi
            done
            sleep 1
        fi
        
        usuarios_procesados=$((usuarios_procesados + 1))
    done
    
    # Si no hay usuarios procesados
    if [ "$usuarios_procesados" -eq 0 ]; then
        echo -e "  ${C_YELLOW}No hay usuarios SSH creados en el sistema.${C_RST}"
    fi
    
    echo -e "${C_NEON_BLUE}╠══════════════════════════════════════════════╣${C_RST}"
    echo -e "  ${C_CYAN}Total usuarios monitoreados: ${C_NEON_YELLOW}$usuarios_procesados${C_RST}"
    echo -e "  ${C_CYAN}Próximo escaneo en: ${C_NEON_YELLOW}6 segundos${C_RST}    "
    echo -e "${C_NEON_BLUE}╚══════════════════════════════════════════════╝${C_RST}"
    
    sleep 6
done